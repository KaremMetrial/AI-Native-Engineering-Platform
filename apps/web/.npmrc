# openapi-typescript's published peer range (typescript@^5.x) hasn't
# caught up to the typescript@~6.0.2 this project pins yet. It's a
# dev-only codegen tool (runs the TS compiler API to parse types for
# `npm run contract:types`, never bundled or executed against our own
# app code), so the mismatch is a stale peer range, not a real
# incompatibility. Without this, `npm ci` fails with ERESOLVE in CI even
# though `npm install` succeeds locally with the same flag passed
# manually -- this makes the behavior consistent everywhere.
legacy-peer-deps=true
